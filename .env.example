# Variables locales de criptografía, conexión EVM y direcciones de contratos desplegados.
# Copiar a .env; no versionar las claves ni inventar direcciones de contratos.

# Semilla EdDSA de la fuente: 32 bytes hexadecimales minúsculos, sin prefijo 0x.
# Mantener vacía si se utiliza --key. Esta identidad nunca se reutiliza como billetera EVM.
SOURCE_EDDSA_PRIVATE_KEY=

# Red seleccionada por los comandos blockchain; localhost funciona sin credenciales externas.
BLOCKCHAIN_NETWORK=localhost

# Nodo EVM local y su identificador de cadena; las cuentas locales las desbloquea el nodo.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Polygon Amoy usa el identificador 80002 y requiere POL de prueba para desplegar o registrar.
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Clave privada de la billetera EVM de despliegue: 32 bytes hexadecimales, con o sin 0x.
# Usar una cuenta de desarrollo financiada en la red elegida. No usar la semilla EdDSA.
# Dejar vacía permite compilar y trabajar localmente sin credenciales de Amoy.
DEPLOYER_PRIVATE_KEY=

# Completar únicamente con las direcciones que devuelva un despliegue realmente ejecutado.
VERIFIER_ADDRESS=
REGISTRY_ADDRESS=

# Raíz Poseidon del conjunto autorizado, expresada como una cadena decimal de campo.
AUTHORIZATION_ROOT=
