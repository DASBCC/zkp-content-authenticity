{
  "name": "autenticidad-multimedia",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "hardhat build && tsc --noEmit",
    "test": "hardhat test",
    "crypto:hash": "node scripts/crypto-cli.mjs hash",
    "crypto:keygen": "node scripts/crypto-cli.mjs keygen",
    "crypto:authorization": "node scripts/crypto-cli.mjs authorization",
    "crypto:sign": "node scripts/crypto-cli.mjs sign",
    "crypto:verify": "node scripts/crypto-cli.mjs verify",
    "crypto:test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.3",
    "circom2": "0.2.23",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.17.0",
    "snarkjs": "0.7.6",
    "typescript": "~6.0.3",
    "viem": "^2.56.8"
  },
  "dependencies": {
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7"
  }
}
