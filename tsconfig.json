{
  "compilerOptions": {
    "lib": [
      "es2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "node20",
    "target": "es2023",
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false
  },
  "exclude": [
    "web",
    "e2e",
    "node_modules",
    "dist",
    ".crypto-build",
    ".zk-artifacts",
    ".local-web",
    "playwright.config.ts"
  ]
}
